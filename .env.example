# Copy to .env for local development. Never commit real secrets.

# --- Postgres / Redis (docker compose dev ports) ---
POSTGRES_USER=cozy
POSTGRES_PASSWORD=cozy_dev_password
POSTGRES_DB=cozy
DATABASE_URL=postgres://cozy:cozy_dev_password@127.0.0.1:55432/cozy
TEST_DATABASE_URL=postgres://cozy:cozy_dev_password@127.0.0.1:55432/cozy_test
REDIS_URL=redis://127.0.0.1:6379

# --- Game API ---
API_PORT=8787
PUBLIC_WEB_ORIGIN=http://localhost:5173
# Shared secret between realtime and API internal endpoints.
INTERNAL_SECRET=dev-internal-secret-change-me
# Emails listed here are granted the admin role on registration.
ADMIN_EMAILS=admin@cozy.local
# Registrations/logins per IP per minute. Raise temporarily for local load tests.
AUTH_RATE_LIMIT_PER_MIN=10

# --- AI gateway (LiteLLM) ---
LITELLM_URL=http://127.0.0.1:4000
LITELLM_MASTER_KEY=sk-cozy-dev-master
LITELLM_SALT_KEY=sk-cozy-dev-salt-change-me
# Base URL shown to players on the API connection screen.
PUBLIC_GATEWAY_URL=http://localhost:4000/v1
# Upstream credentials. Only the LiteLLM container receives these.
UPSTREAM_KEY_MOCK=mock-upstream-secret
UPSTREAM_KEY_1=
UPSTREAM_KEY_2=
UPSTREAM_KEY_3=
UPSTREAM_KEY_NEWAPI=

# --- Realtime ---
REALTIME_PORT=2567
API_INTERNAL_URL=http://127.0.0.1:8787

# --- Web (Vite) ---
VITE_API_URL=http://localhost:8787
VITE_REALTIME_URL=ws://localhost:2567

# --- SMTP / Email OTP ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Cozy Social MMO <no-reply@cozy.local>"
REQUIRE_EMAIL_VERIFICATION=false
