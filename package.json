{
  "name": "cozy-compute",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "deps:up": "docker compose up -d postgres redis litellm mock-upstream",
    "deps:down": "docker compose down",
    "migrate": "pnpm --filter @cozy/api migrate",
    "dev": "pnpm --parallel --filter @cozy/api --filter @cozy/realtime --filter @cozy/web dev",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test infra/deploy/deploy.test.mjs && pnpm -r --workspace-concurrency=1 test",
    "build": "pnpm --filter @cozy/realtime --filter @cozy/api --filter @cozy/web build",
    "e2e:gateway": "pnpm --filter @cozy/api e2e:gateway",
    "loadtest": "pnpm --filter @cozy/realtime loadtest",
    "version:sync": "node scripts/sync-version.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^16.4.0",
    "prettier": "^3.6.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0"
  }
}
