{
  admin off
  auto_https off
}

http://:{$PROXY_PORT} {
  bind 127.0.0.1
  encode zstd gzip
  root * {$WEB_ROOT}

  @private path /internal /internal/* /api/internal /api/internal/* /metrics /api/metrics /realtime/metrics
  handle @private {
    respond 404
  }

  handle_path /api/* {
    reverse_proxy 127.0.0.1:{$API_PORT} {
      header_up X-Forwarded-For {http.request.header.CF-Connecting-IP}
    }
  }

  handle_path /realtime/* {
    reverse_proxy 127.0.0.1:{$REALTIME_PORT}
  }

  handle /v1/* {
    reverse_proxy {$LITELLM_URL}
  }

  handle /assets/* {
    header Cache-Control "public, max-age=31536000, immutable"
    file_server
  }

  handle /version.txt {
    header Cache-Control "no-store"
    file_server
  }

  handle {
    header Cache-Control "no-cache"
    try_files {path} /index.html
    file_server
  }
}
