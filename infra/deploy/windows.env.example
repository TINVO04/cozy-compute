# Save outside the checkout as D:/CozyGameProduction/.env. Never commit secrets.
GAME_DOMAIN=play.devtizo.vip
PROXY_PORT=8082
CONTROL_PORT=8083
API_PORT=8788
REALTIME_PORT=2568
CADDY_EXECUTABLE=D:/CozyGameProduction/bin/caddy.exe
PG_DUMP_EXECUTABLE=C:/Program Files/PostgreSQL/17/bin/pg_dump.exe
# Existing local PostgreSQL cluster; use a separate production database and role.
PG_CTL_EXECUTABLE=C:/Program Files/PostgreSQL/17/bin/pg_ctl.exe
POSTGRES_DATA_DIR=D:/Game_Cua_Bao/infra/postgres/local_data
POSTGRES_PORT=55432
DATABASE_URL=
# Dedicated production Redis; no pubsub/positions shared with pnpm dev.
REDIS_URL=redis://127.0.0.1:56380/0
REDIS_EXECUTABLE=
# At least 32 random bytes each; these must be different.
INTERNAL_SECRET=
CONTROL_SECRET=
ADMIN_EMAILS=
# Real native LiteLLM gateway, if installed; no mock upstream in production.
LITELLM_URL=http://127.0.0.1:4000
LITELLM_MASTER_KEY=
# SMTP / Email OTP Verification
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
REQUIRE_EMAIL_VERIFICATION=true
